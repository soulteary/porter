{
  "listen": ":8083",
  "public_url": "https://login.example.com",
  "landing_url": "https://login.example.com/",
  "database": "/data/porter.db",
  "development": false,
  "session_seconds": 28800,
  "providers": {
    "github": {
      "client_id": "GITHUB_CLIENT_ID",
      "client_secret_file": "/run/secrets/github-client-secret"
    },
    "google": {
      "client_id": "GOOGLE_CLIENT_ID",
      "client_secret_file": "/run/secrets/google-client-secret"
    },
    "wechat": {
      "client_id": "WECHAT_APP_ID",
      "client_secret_file": "/run/secrets/wechat-client-secret"
    },
    "qq": {
      "client_id": "QQ_APP_ID",
      "client_secret_file": "/run/secrets/qq-client-secret"
    }
  },
  "bindings": [],
  "stargate_url": "http://stargate:8080/_auth",
  "allow_insecure_stargate": true,
  "operations": {
    "listen": "127.0.0.1:9093",
    "audit_file": "/data/porter-audit.jsonl",
    "log_level": "info",
    "audit_queue_size": 1024,
    "probe_timeout_seconds": 2,
    "key_file": "/run/secrets/porter-management-key"
  },
  "proxy_key_file": "/run/secrets/porter-proxy-key",
  "stargate_secret_file": "/run/secrets/porter-stargate-secret"
}
